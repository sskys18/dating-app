{
  "name": "dating-app",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @dating-app/db generate",
    "db:push": "pnpm --filter @dating-app/db push",
    "db:seed": "pnpm --filter @dating-app/db seed",
    "db:studio": "pnpm --filter @dating-app/db studio",
    "db:migrate": "pnpm --filter @dating-app/db migrate",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
