generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 16-Type Catalog ───────────────────────────────────────────────

model TypeCatalog {
  id          Int    @id // 0-15, binary encoding of 4 axis poles
  code        String @unique @db.VarChar(32) // e.g. "CLOSE_CALM_COMMIT_ENGAGE"
  label       String @db.VarChar(100)
  labelKo     String @map("label_ko") @db.VarChar(100)
  labelJa     String? @map("label_ja") @db.VarChar(100)
  description String @db.Text
  descriptionKo String @map("description_ko") @db.Text
  descriptionJa String? @map("description_ja") @db.Text
  axisAPole   String @map("axis_a_pole") @db.VarChar(10) // CLOSE | DIST
  axisBPole   String @map("axis_b_pole") @db.VarChar(10) // CALM | NEED
  axisCPole   String @map("axis_c_pole") @db.VarChar(10) // COMMIT | EXPLORE
  axisDPole   String @map("axis_d_pole") @db.VarChar(10) // ENGAGE | PAUSE
  version     Int    @default(1) @map("catalog_version")
  createdAt   DateTime @default(now()) @map("created_at")

  quizResponses QuizResponse[]
  users         User[]

  @@map("type_catalog")
}

// ─── Anonymous Session ─────────────────────────────────────────────

model AnonSession {
  id          String   @id @default(cuid())
  ipHash      String   @map("ip_hash") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  locale      String   @default("en-US") @db.VarChar(10)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quizResponse  QuizResponse?
  chatSession   ChatSession?
  handoffTokens HandoffToken[]

  @@index([ipHash, createdAt])
  @@map("anon_session")
}

// ─── Quiz ──────────────────────────────────────────────────────────

model QuizResponse {
  id           String   @id @default(cuid())
  sessionId    String   @unique @map("session_id")
  answers      Json     // int[] of 12 answers (0=A, 1=B)
  axisScores   Json     @map("axis_scores") // { a: 0-3, b: 0-3, c: 0-3, d: 0-3 }
  axisPoles    Json     @map("axis_poles") // { a: "CLOSE"|"DIST", ... }
  typeId       Int      @map("type_id")
  quizVersion  Int      @default(1) @map("quiz_version")
  progress     Json?    // partial answers for resume
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session AnonSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type    TypeCatalog   @relation(fields: [typeId], references: [id])

  @@index([typeId])
  @@map("quiz_response")
}

// ─── Persona Chat Session ──────────────────────────────────────────

model ChatSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique @map("session_id")
  turnCount     Int      @default(0) @map("turn_count")
  maxTurns      Int      @default(10) @map("max_turns")
  messages      Json     @default("[]") // Array of { role, content, timestamp }
  systemPrompt  String?  @map("system_prompt") @db.Text
  profileDraft  Json?    @map("profile_draft") // OUT-01
  matchingCriteria Json? @map("matching_criteria") // OUT-02
  messageStarters Json?  @map("message_starters") // OUT-03
  totalTokens   Int      @default(0) @map("total_tokens")
  status        String   @default("active") @db.VarChar(20) // active | completed | expired
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  session AnonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_session")
}

// ─── Handoff Token ─────────────────────────────────────────────────

model HandoffToken {
  id          String    @id @default(cuid())
  token       String    @unique @db.VarChar(128)
  sessionId   String    @map("session_id")
  userId      String?   @map("user_id")
  claimedAt   DateTime? @map("claimed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  session AnonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([expiresAt])
  @@map("handoff_token")
}

// ─── Authenticated User ────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String?  @unique @db.VarChar(255)
  nickname      String?  @db.VarChar(50)
  birthDate     DateTime? @map("birth_date")
  gender        String?  @db.VarChar(20)
  bio           String?  @db.Text
  introLine     String?  @map("intro_line") @db.VarChar(200)
  locationLat   Float?   @map("location_lat")
  locationLng   Float?   @map("location_lng")
  locationLabel String?  @map("location_label") @db.VarChar(100)
  typeId        Int?     @map("type_id")
  typeVisible   Boolean  @default(false) @map("type_visible")
  axisCVisible  Boolean  @default(false) @map("axis_c_visible")
  profileComplete Boolean @default(false) @map("profile_complete")
  incognitoEnabled Boolean @default(false) @map("incognito_enabled")
  travelLat     Float?   @map("travel_lat")
  travelLng     Float?   @map("travel_lng")
  travelActive  Boolean  @default(false) @map("travel_active")
  role          String   @default("user") @db.VarChar(20) // user | admin
  status        String   @default("active") @db.VarChar(20) // active | banned | deleted
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  type           TypeCatalog?    @relation(fields: [typeId], references: [id])
  preferences    UserPreferences?
  authProviders  AuthProvider[]
  photos         UserPhoto[]
  subscription   Subscription?
  matchingCriteria UserMatchingCriteria?
  messageStarters  UserMessageStarters?
  handoffTokens  HandoffToken[]
  likesGiven     Like[]         @relation("LikesGiven")
  likesReceived  Like[]         @relation("LikesReceived")
  matchesAsA     Match[]        @relation("MatchUserA")
  matchesAsB     Match[]        @relation("MatchUserB")
  sentMessages   Message[]
  blocksInitiated Block[]       @relation("BlockInitiator")
  blocksReceived  Block[]       @relation("BlockTarget")
  reportsInitiated Report[]     @relation("ReportInitiator")
  reportsReceived  Report[]     @relation("ReportTarget")
  deviceTokens   DeviceToken[]

  @@index([typeId])
  @@index([status])
  @@index([lastActiveAt])
  @@map("user")
}

// ─── Auth Providers ────────────────────────────────────────────────

model AuthProvider {
  id           String @id @default(cuid())
  userId       String @map("user_id")
  provider     String @db.VarChar(20) // apple | google | kakao
  providerUid  String @map("provider_uid") @db.VarChar(255)
  email        String? @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("auth_provider")
}

// ─── User Photos ───────────────────────────────────────────────────

model UserPhoto {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  url       String  @db.VarChar(512)
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")
  status    String  @default("pending") @db.VarChar(20) // pending | approved | rejected
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_photo")
}

// ─── Subscription ──────────────────────────────────────────────────

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  plan                  String    @db.VarChar(20) // free | plus | premium
  sku                   String?   @db.VarChar(50) // IAP SKU
  originalTransactionId String?   @map("original_transaction_id") @db.VarChar(255)
  expiresAt             DateTime? @map("expires_at")
  status                String    @default("active") @db.VarChar(20) // active | expired | cancelled | billing_retry
  autoRenew             Boolean   @default(true) @map("auto_renew")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([originalTransactionId])
  @@index([expiresAt])
  @@map("subscription")
}

// ─── User Preferences (discovery filters) ──────────────────────────

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  ageMin        Int?     @map("age_min")
  ageMax        Int?     @map("age_max")
  maxDistanceKm Int?     @map("max_distance_km")
  genderPref    String?  @map("gender_pref") @db.VarChar(20) // male | female | all
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── User Matching Criteria (from persona chat OUT-02) ─────────────

model UserMatchingCriteria {
  id           String @id @default(cuid())
  userId       String @unique @map("user_id")
  dealbreakers Json   @default("[]")
  greenFlags   Json   @default("[]") @map("green_flags")
  weights      Json   @default("{}") // axis weights + extras
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_matching_criteria")
}

// ─── User Message Starters (from persona chat OUT-03) ──────────────

model UserMessageStarters {
  id       String @id @default(cuid())
  userId   String @unique @map("user_id")
  starters Json   @default("[]") // string[3]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_message_starters")
}

// ─── Likes ─────────────────────────────────────────────────────────

model Like {
  id         String   @id @default(cuid())
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  action     String   @db.VarChar(10) // like | pass
  priority   Boolean  @default(false) // priority-likes ranking boost
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser User @relation("LikesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, action])
  @@map("like")
}

// ─── Matches ───────────────────────────────────────────────────────

model Match {
  id        String   @id @default(cuid())
  userAId   String   @map("user_a_id") // userAId < userBId for uniqueness
  userBId   String   @map("user_b_id")
  status    String   @default("active") @db.VarChar(20) // active | unmatched
  createdAt DateTime @default(now()) @map("created_at")

  userA    User      @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  chatRoom ChatRoom?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("match")
}

// ─── Chat Rooms ────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  matchId   String   @unique @map("match_id")
  starters  Json     @default("[]") // string[3] message starters
  createdAt DateTime @default(now()) @map("created_at")

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("chat_room")
}

// ─── Messages ──────────────────────────────────────────────────────

model Message {
  id          String    @id @default(cuid())
  chatRoomId  String    @map("chat_room_id")
  senderId    String    @map("sender_id")
  content     String    @db.Text
  status      String    @default("sent") @db.VarChar(20) // sent | delivered | read
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
  @@index([senderId])
  @@map("message")
}

// ─── Blocks ────────────────────────────────────────────────────────

model Block {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  blockedId  String   @map("blocked_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User @relation("BlockInitiator", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
  @@map("block")
}

// ─── Reports ───────────────────────────────────────────────────────

model Report {
  id           String   @id @default(cuid())
  reporterId   String   @map("reporter_id")
  reportedId   String   @map("reported_id")
  reason       String   @db.VarChar(50)
  description  String?  @db.Text
  snapshot     Json?    // evidence: profile + last 50 messages
  status       String   @default("pending") @db.VarChar(20) // pending | reviewed | resolved | dismissed
  resolvedAt   DateTime? @map("resolved_at")
  resolvedBy   String?  @map("resolved_by")
  createdAt    DateTime @default(now()) @map("created_at")

  reporter User @relation("ReportInitiator", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportTarget", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reportedId])
  @@map("report")
}

// ─── Device Tokens (Push) ──────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  platform  String   @db.VarChar(10) // ios | android
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_token")
}
